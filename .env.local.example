# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. Never commit real tokens.

# Contentful > Settings > General settings > Space ID
CONTENTFUL_SPACE_ID=

# Contentful > Settings > API keys > Content Delivery API - access token
CONTENTFUL_ACCESS_TOKEN=

# Contentful > Settings > API keys > Content Preview API - access token
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# Contentful > Settings > CMA tokens > personal access token (starts with CFPAT-)
# Only needed by `npm run setup`. You can delete the token afterwards.
CONTENTFUL_MANAGEMENT_TOKEN=
